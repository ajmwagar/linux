# SPDX-License-Identifier: GPL-2.0
# Minimal arm64 pager config for TCL 4058G / MT6739 earlycon milestone.
# Apply on top of `make ARCH=arm64 tinyconfig`:
#   scripts/kconfig/merge_config.sh -O OUT OUT/.config tools/mt6739-pager.config
#   make ARCH=arm64 O=OUT olddefconfig
# Then: make ARCH=arm64 O=OUT Image dtbs/mediatek/mt6739-tcl-4058g-pager.dtb

# --- platform / SMP / interrupt controller ---------------------------------
CONFIG_ARCH_MEDIATEK=y
CONFIG_SMP=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
# CONFIG_ARM_GIC_V3_ITS is not set
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM64_ERRATUM_843419=y
CONFIG_ARM64_ERRATUM_845719=y

# --- console: 8250 + MediaTek variant, earlycon ----------------------------
CONFIG_TTY=y
CONFIG_PRINTK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_EARLYCON=y
# CONFIG_SERIAL_8250_DMA is not set
CONFIG_COMMON_CLK=y

# --- initramfs / 32-bit EL0 userspace --------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_COMPAT=y
# CONFIG_COMPAT_VDSO is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y

# --- keep it deterministic and small ---------------------------------------
# CONFIG_MODULES is not set
# CONFIG_EFI is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
